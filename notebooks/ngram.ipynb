      "\u001b[36mFile \u001b[39m\u001b[32m~\\Smart-Autocomplete-Systems\\.venv\\Lib\\site-packages\\huggingface_hub\\utils\\_hf_uris.py:319\u001b[39m, in \u001b[36mparse_hf_uri\u001b[39m\u001b[34m(uri, endpoint)\u001b[39m\n\u001b[32m    317\u001b[39m \u001b[38;5;28;01mif\u001b[39;00m type_ == \u001b[33m\"\u001b[39m\u001b[33mbucket\u001b[39m\u001b[33m\"\u001b[39m:\n\u001b[32m    318\u001b[39m     \u001b[38;5;28;01mreturn\u001b[39;00m _parse_bucket_body(location, type_, raw=raw)\n\u001b[32m--> \u001b[39m\u001b[32m319\u001b[39m \u001b[38;5;28;01mreturn\u001b[39;00m \u001b[30;43m_parse_repo_body\u001b[39;49m\u001b[30;43m(\u001b[39;49m\u001b[30;43mlocation\u001b[39;49m\u001b[30;43m,\u001b[39;49m\u001b[30;43m \u001b[39;49m\u001b[30;43mtype_\u001b[39;49m\u001b[30;43m,\u001b[39;49m\u001b[30;43m \u001b[39;49m\u001b[30;43mraw\u001b[39;49m\u001b[30;43m=\u001b[39;49m\u001b[30;43mraw\u001b[39;49m\u001b[30;43m)\u001b[39;49m\n",
      "\u001b[36mFile \u001b[39m\u001b[32m~\\Smart-Autocomplete-Systems\\.venv\\Lib\\site-packages\\huggingface_hub\\utils\\_hf_uris.py:617\u001b[39m, in \u001b[36m_parse_repo_body\u001b[39m\u001b[34m(location, type_, raw)\u001b[39m\n\u001b[32m    615\u001b[39m     \u001b[38;5;28;01mraise\u001b[39;00m HfUriError(uri=raw, msg=\u001b[33m\"\u001b[39m\u001b[33mMissing repository id before \u001b[39m\u001b[33m'\u001b[39m\u001b[33m@\u001b[39m\u001b[33m'\u001b[39m\u001b[33m.\u001b[39m\u001b[33m\"\u001b[39m)\n\u001b[32m    616\u001b[39m \u001b[38;5;28;01mif\u001b[39;00m repo_id.count(\u001b[33m\"\u001b[39m\u001b[33m/\u001b[39m\u001b[33m\"\u001b[39m) != \u001b[32m1\u001b[39m:\n\u001b[32m--> \u001b[39m\u001b[32m617\u001b[39m     \u001b[38;5;28;01mraise\u001b[39;00m HfUriError(uri=raw, msg=\u001b[33mf\u001b[39m\u001b[33m\"\u001b[39m\u001b[33mRepository id must be \u001b[39m\u001b[33m'\u001b[39m\u001b[33mnamespace/name\u001b[39m\u001b[33m'\u001b[39m\u001b[33m, got \u001b[39m\u001b[33m'\u001b[39m\u001b[38;5;132;01m{\u001b[39;00mrepo_id\u001b[38;5;132;01m}\u001b[39;00m\u001b[33m'\u001b[39m\u001b[33m.\u001b[39m\u001b[33m\"\u001b[39m)\n\u001b[32m    618\u001b[39m \u001b[38;5;66;03m# Special refs like 'refs/pr/10' contain '/' and must be matched eagerly,\u001b[39;00m\n\u001b[32m    619\u001b[39m \u001b[38;5;66;03m# otherwise we would split them at the first '/' and treat the rest as a path.\u001b[39;00m\n\u001b[32m    620\u001b[39m match = _SPECIAL_REFS_REVISION_REGEX.match(rev_and_path)\n",
