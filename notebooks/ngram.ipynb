      "\u001b[36mFile \u001b[39m\u001b[32m~\\Smart-Autocomplete-Systems\\.venv\\Lib\\site-packages\\datasets\\utils\\file_utils.py:180\u001b[39m, in \u001b[36mcached_path\u001b[39m\u001b[34m(url_or_filename, download_config, **download_kwargs)\u001b[39m\n\u001b[32m    174\u001b[39m \u001b[38;5;66;03m# Download files from Hugging Face.\u001b[39;00m\n\u001b[32m    175\u001b[39m \u001b[38;5;66;03m# Note: no need to check for https://huggingface.co file URLs since _prepare_path_and_storage_options\u001b[39;00m\n\u001b[32m    176\u001b[39m \u001b[38;5;66;03m# prepares Hugging Face HTTP URLs as hf:// paths already\u001b[39;00m\n\u001b[32m    177\u001b[39m \u001b[38;5;28;01mif\u001b[39;00m url_or_filename.startswith(\u001b[33m\"\u001b[39m\u001b[33mhf://\u001b[39m\u001b[33m\"\u001b[39m) \u001b[38;5;129;01mand\u001b[39;00m \u001b[38;5;129;01mnot\u001b[39;00m url_or_filename.startswith(\u001b[33m\"\u001b[39m\u001b[33mhf://buckets/\u001b[39m\u001b[33m\"\u001b[39m):\n\u001b[32m    178\u001b[39m     resolved_path = \u001b[30;43mhuggingface_hub\u001b[39;49m\u001b[30;43m.\u001b[39;49m\u001b[30;43mHfFileSystem\u001b[39;49m\u001b[30;43m(\u001b[39;49m\n\u001b[32m    179\u001b[39m \u001b[30;43m        \u001b[39;49m\u001b[30;43mendpoint\u001b[39;49m\u001b[30;43m=\u001b[39;49m\u001b[30;43mconfig\u001b[39;49m\u001b[30;43m.\u001b[39;49m\u001b[30;43mHF_ENDPOINT\u001b[39;49m\u001b[30;43m,\u001b[39;49m\u001b[30;43m \u001b[39;49m\u001b[30;43mtoken\u001b[39;49m\u001b[30;43m=\u001b[39;49m\u001b[30;43mdownload_config\u001b[39;49m\u001b[30;43m.\u001b[39;49m\u001b[30;43mtoken\u001b[39;49m\n\u001b[32m--> \u001b[39m\u001b[32m180\u001b[39m \u001b[30;43m    \u001b[39;49m\u001b[30;43m)\u001b[39;49m\u001b[30;43m.\u001b[39;49m\u001b[30;43mresolve_path\u001b[39;49m\u001b[30;43m(\u001b[39;49m\u001b[30;43murl_or_filename\u001b[39;49m\u001b[30;43m)\u001b[39;49m\n\u001b[32m    181\u001b[39m     \u001b[38;5;28;01mtry\u001b[39;00m:\n\u001b[32m    182\u001b[39m         output_path = huggingface_hub.HfApi(\n\u001